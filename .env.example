APP_NAME=Crypto AI Intelligence
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1
DATABASE_URL=sqlite:///./crypto_ai.db
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:8080


# Persistent market-data collectors (public Binance streams; no API key required)
CVD_COLLECTOR_ENABLED=true
CVD_COLLECTOR_SYMBOLS=BTCUSDT
CVD_COLLECTOR_FLUSH_INTERVAL_SECONDS=2.0
LIQUIDATION_COLLECTOR_ENABLED=true
LIQUIDATION_COLLECTOR_SYMBOLS=BTCUSDT
LIQUIDATION_COLLECTOR_FLUSH_INTERVAL_SECONDS=2.0

# V8 TradingAgents job API is deliberately disabled until a persistent agent worker is deployed.
TRADINGAGENTS_ENABLED=false
TRADINGAGENTS_POLL_INTERVAL_SECONDS=5
TRADINGAGENTS_OUTPUT_LANGUAGE=Indonesian
TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
TRADINGAGENTS_MAX_RISK_ROUNDS=1
TRADINGAGENTS_MAX_TOOL_ROUNDS=4
TRADINGAGENTS_RESULTS_DIR=/data/tradingagents/results
TRADINGAGENTS_CACHE_DIR=/data/tradingagents/cache
TRADINGAGENTS_MEMORY_LOG_PATH=/data/tradingagents/memory/trading_memory.md

# Configure provider credentials ONLY in the agent worker environment, never commit them.
# Examples: OPENAI_API_KEY, GOOGLE_API_KEY, ANTHROPIC_API_KEY.
